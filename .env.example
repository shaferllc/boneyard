APP_NAME=Boneyard
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000
APP_KEY=

DB_CONNECTION=sqlite
DB_URL=file:./database.sqlite

# Stripe. Leave both blank locally: with no secret key, burials complete without
# payment so the site is usable without an account. In production, set them —
# `wrangler secret put STRIPE_SECRET_KEY`, never wrangler.jsonc vars.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
